{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "forkProcessing": "enabled",
  "nix": {
    "enabled": true
  },
  "timezone": "America/Chicago",
  "schedule": [
    "* 6-10 * * *"
  ],
  "prConcurrentLimit": 1,
  "automerge": false,
  "dependencyDashboard": true,
  "baseBranchPatterns": [
    "main"
  ],
  "enabledManagers": [
    "nix",
    "github-actions",
    "custom.regex",
    "pip_requirements"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 6-10 * * 0"
    ],
    "groupName": "System dependencies",
    "groupSlug": "system-dependencies"
  },
  "packageRules": [
    {
      "description": "Refresh branch-tracking flakes through lock-file maintenance; do not rewrite channel URLs with digests",
      "matchManagers": [
        "nix"
      ],
      "groupName": "System dependencies",
      "pinDigests": false,
      "groupSlug": "system-dependencies"
    },
    {
      "description": "Media policy data needs a deliberate manual update",
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "trash-guides",
        "recyclarr-templates"
      ],
      "enabled": false
    },
    {
      "description": "Keep the host on its existing NixOS release",
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "nixpkgs-host"
      ],
      "allowedVersions": "/^nixos-26\\.05$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "CI tooling",
      "groupSlug": "ci-tooling"
    },
    {
      "description": "Keep the validator on its supported Node 24 runtime; review Renovate engines before raising this bound",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "node"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml"
      ],
      "allowedVersions": "/^24\\./"
    },
    {
      "matchDepNames": [
        "renovate",
        "PyYAML"
      ],
      "groupName": "CI tooling",
      "groupSlug": "ci-tooling"
    },
    {
      "matchDatasources": [
        "docker",
        "github-releases"
      ],
      "groupName": "Media applications",
      "groupSlug": "media-applications",
      "matchManagers": [
        "custom.regex"
      ]
    },
    {
      "matchDepNames": [
        "caddyserver/replace-response"
      ],
      "groupName": "System dependencies",
      "groupSlug": "system-dependencies",
      "pinDigests": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "prPriority": 10
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^hosts/nixflix/containers\\.json$/"
      ],
      "matchStrings": [
        "\"(?:mylar3|stash)\"\\s*:\\s*\"(?<depName>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "currentValueTemplate": "latest",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/package-versions\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>Notifiarr/notifiarr|Maintainerr/Maintainerr)\"\\s*:\\s*\"(?<currentValue>[^\" ]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/package-versions\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>caddyserver/replace-response)\"\\s*:\\s*\"(?<currentValue>master)@(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "github-digest"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/package-versions\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>Whisparr/Whisparr)\"\\s*:\\s*\"(?<currentValue>[^\" ]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<major>2)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-release\\.(?<build>\\d+)$",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=npm depName=renovate\\s+- run: npx --yes --package renovate@(?<currentValue>[^ ]+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate",
      "versioningTemplate": "npm"
    }
  ],
  "branchConcurrentLimit": 1,
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ]
}
